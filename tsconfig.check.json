// Specialized tsconfig for type-checking js files
{
	"extends": "./tsconfig.json",
	"compilerOptions": {},
	"include": [
		"**/*.js",
		"**/*.d.ts"
	],
	"exclude": [
		"**/build",
		"node_modules/",
		"widgets/",
		// test files are type-checked via test/tsconfig.json; they rely on mocha globals
		"**/*.test.js"
	]
}
